SERVER__HOST="konobangu.example"
# Optional canonical API address for RSS self-links (supports a proxy prefix):
# SERVER__EXTERNAL_BASE_URL="https://api.konobangu.example"
DATABASE__URL_FILE="/run/secrets/database_uri"
DATABASE__MIGRATION__AUTO_RUN=true
# Optional separate owner credential for managed migrations:
# DATABASE__MIGRATION__URL_FILE="/run/secrets/migration_uri"
# DATABASE__MIGRATION__LEGACY_OIDC_ISSUER="https://idp.example/"
AUTH__WEBUI__ALLOWED_ORIGINS='[{type="strict",value="https://konobangu.example"}]'
# Built-in issuer; expose this stable HTTPS address through the reverse proxy.
AUTH__PROVIDER__TYPE="bundled"
AUTH__PROVIDER__ISSUER="https://api.konobangu.example/auth-provider"
AUTH__PROVIDER__CLIENT__CLIENT_ID="konobangu-webui"
AUTH__PROVIDER__CLIENT__REDIRECT_URIS='["https://konobangu.example/auth/callback"]'
AUTH__PROVIDER__CREDENTIALS__USERNAME="administrator"
AUTH__PROVIDER__CREDENTIALS__PASSWORD_FILE="/run/secrets/administrator_password"
AUTH__PROVIDER__SIGNING__PRIVATE_KEY_PEM_FILE="/run/secrets/oidc_private_key.pem"
# To use an external issuer, replace the bundled provider fields above with:
# AUTH__PROVIDER__TYPE="oidc"
# AUTH__PROVIDER__ISSUER="https://idp.example/"
# AUTH__PROVIDER__BROWSER__CLIENT_ID="konobangu-webui"
# The external browser client is public: PKCE S256 and auth method none.
# AUTH__ADMINISTRATORS='[{issuer="https://idp.example/",subject="operator-subject"}]'
# Independent 32-byte unpadded-base64url key shared by recorder replicas:
# AUTH__RESOURCE_GRANTS__SIGNING_KEY_FILE="/run/secrets/resource_signing_key"
# Omission generates an ephemeral process key; restarting invalidates image grants.
# The API audience is deliberately distinct from the browser client ID.
# AUTH__PROVIDER__RESOURCE__AUDIENCE="urn:konobangu:api"
# File contents are literal UTF-8; create URI files without a trailing newline.
# Do not also set the corresponding ordinary canonical value (even empty).
# See docs/en/004-MEDIA-AND-CONFIGURATION.md for Compose secret mounts.
# See docs/en/002-AUTHENTICATION-DECISION.md before migrating existing data.
# Automatic media inherits JXL + WebP; a trimmed build inherits WebP only.
# Optional explicit policy (an empty list disables automatic derivatives):
# MEDIA__AUTO_OPTIMIZE_FORMATS=["image/webp"]
