LOGGER__LEVEL = "debug"

DATABASE__URL = "postgres://konobangu:konobangu@localhost:5432/konobangu"
DATABASE__MIGRATION__AUTO_RUN = true
AUTH__WEBUI__ALLOWED_ORIGINS = '[{type="strict",value="http://localhost:5000"}]'
# Startup provisions NOLOGIN capabilities; auth and scheduler inherit the database URL.
# See docs/en/002-AUTHENTICATION-DECISION.md.

AUTH__PROVIDER__TYPE = "bundled"
AUTH__PROVIDER__ISSUER = "http://localhost:5001/auth-provider"
AUTH__PROVIDER__CLIENT__CLIENT_ID = "konobangu-webui"
AUTH__PROVIDER__CLIENT__REDIRECT_URIS = '["http://localhost:5000/auth/callback"]'
AUTH__PROVIDER__CREDENTIALS__USERNAME = "konobangu"
AUTH__PROVIDER__CREDENTIALS__PASSWORD = "konobangu"
# Supply the persistent RSA private key through the process environment:
# AUTH__PROVIDER__SIGNING__PRIVATE_KEY_PEM_FILE = "/absolute/path/to/development-oidc-key.pem"
# The authentication document describes cross-platform Node key generation.


MIKAN__HTTP_CLIENT__PROXY__ACCEPT_INVALID_CERTS = true
MIKAN__HTTP_CLIENT__PROXY__SERVER = "http://127.0.0.1:8899"
